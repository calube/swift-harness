{
  "description": "swift-harness: route every gate through swiftgate. No-ops outside a project with .swiftgate.toml, except the review agents' Bash limit.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/swiftgate",
            "args": ["hook", "session-start"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|WebFetch|WebSearch|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/swiftgate",
            "args": ["hook", "pre-tool-use"],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/swiftgate",
            "args": ["hook", "post-tool-use"],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/swiftgate",
            "args": ["hook", "stop"],
            "timeout": 180,
            "statusMessage": "swiftgate check --tier fast"
          }
        ]
      }
    ]
  }
}
