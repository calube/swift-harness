[
  {
    "command": "open",
    "input": {
      "app": "com.example.InterviewStarter",
      "relaunch": true,
      "launchArgs": [
        "-harness-scenario",
        "success"
      ]
    }
  },
  {
    "command": "wait",
    "input": {
      "kind": "selector",
      "selector": "id=\"watchlist.price.bitcoin\"",
      "timeoutMs": 15000
    }
  },
  {
    "command": "is",
    "input": {
      "predicate": "text",
      "selector": "id=\"watchlist.price.bitcoin\"",
      "value": "$64,000.00"
    }
  },
  {
    "command": "gesture",
    "input": {
      "kind": "drag",
      "source": "id=\"watchlist.row.bitcoin\"",
      "destination": "id=\"watchlist.bottom\""
    }
  },
  {
    "command": "wait",
    "input": {
      "kind": "text",
      "text": "$64,001.00",
      "timeoutMs": 15000
    }
  },
  {
    "command": "is",
    "input": {
      "predicate": "text",
      "selector": "id=\"watchlist.price.bitcoin\"",
      "value": "$64,001.00"
    }
  }
]
