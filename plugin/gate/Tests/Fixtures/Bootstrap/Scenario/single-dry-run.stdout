+++ b/.swiftgate.toml
@@ -0,0 +1,113 @@
+# swiftgate project profile. `swiftgate bootstrap` writes this file once and never rewrites it;
+# edit it freely. Shape: the swift-harness design spec, section 5.4.
+schema = 1
+xcode = "26.2"
+app_scheme = "SampleApp"
+packages = ["Packages/*"]
+
+[simulator]
+device = "iPhone 17"
+os = "26.2"
+
+# T3 UI flows are a closed list (testing playbook P11). Declare one entry per XCUITest flow:
+# [[flows]]
+# name = "checkout"
+# reason = "revenue-critical; crosses three features"
+
+# Modules that deviate from the defaults (kind "feature", host-testable) need an entry.
+# Kinds: feature | engine | render | library | client | test-support.
+# [[modules]]
+# name = "GameEngine"
+# kind = "engine"
+# reason = "60Hz fixed-timestep simulation; per-frame store overhead unjustified"
+
+# Vendor SDK modules allowed only inside *Live modules:
+# [clients]
+# vendor_modules = ["FirebaseAnalytics"]
+
+# docs-lint and prose: the routers bootstrap stamps are managed files. Repo-specific anchors,
+# banned phrases (each needs a reason) and per-file word budgets are opt-in. Router and topic
+# default to 400 / 800 words; AGENTS.md defaults to 60 lines; a whole design doc defaults to
+# ~1,200 words.
+[docs]
+managed_files = ["docs/index.md", "AGENTS.md"]
+
+# [[docs.banned_phrases]]
+# phrase = "leverage"
+# reason = "vague business jargon; say what changed"
+#
+# [docs.budgets]
+# router = 400
+# topic = 800
+# [docs.budgets.sections]
+# architecture defaults to 80 words (spec §5.3); an entry here overrides it and merges over,
+# rather than replacing, the other section defaults.
+# architecture = 120
+
+# The test-quality judge sends test source and diffs to a model, so it is off until a repository
+# opts in. Each threshold is optional and defaults to the value shown. `backend = "jev"` also needs `send_to = "api.typesafe.ai"`,
+# naming the third-party host, and its `model` must be a versioned id (default "jev-1.13.0"; the
+# aliases "jev-latest" and "jev-preview" are refused). The API key never goes here: Jev reads it
+# from TYPESAFE_API_KEY in the environment.
+# [judge]
+# backend = "claude"           # none | claude | jev
+# advisory_threshold = 0.6    # default
+# block_threshold = 0.9        # default
+# send_to = "api.typesafe.ai"  # with backend = "jev" only
+
+# Local telemetry: gate runs, steps and test results, hook decisions, cache lookups, build halts
+# and agent token counts, as JSON lines under .harness/events/. On by default; nothing leaves the
+# machine. `enabled = false` stops every kind except the judge's audit log, which a configured
+# [judge] always writes. See the plugin's docs/telemetry.md.
+# [telemetry]
+# enabled = false
+
+# Simulator QA: `swiftgate sim up` holds its device until `sim down`, the agent-device session
+# ends, or this many minutes pass (1 to 240).
+# [qa]
+# session_timeout_minutes = 30
+
+# Dependency scenarios `swiftgate sim up --scenario <name>` may launch the app in. Each name is a
+# case of the app's `enum Scenario: String` (bootstrap stamps `Scenario.swift` with `live` beside
+# a single `@main` app file); `swiftgate arch` fails when the two lists differ.
+[[scenarios]]
+name = "live"
+reason = "the app's own live dependencies, as it ships"
+
+# Bounds swiftgate's plan workflows enforce on a decomposed plan (design spec §9.3).
+# [plan]
+# max_parallel = 3
+
+# What this repository is optimised for: the `[build.presets.<name>]` table `/swift-harness:build`
+# and `/swift-harness:ship` use when given no --preset. It only picks a preset; hooks, test-first
+# rules and the merge gate stay the same. `swiftgate doctor` fails a profile naming no preset.
+[harness]
+profile = "default"
+
+# Named `build` presets (design spec §5.1). Every key is required: a typo fails `swiftgate doctor`
+# rather than falling back to a default without warning.
+[build.presets.default]
+design_tier = "standard"
+max_parallel = 3
+review = "full"            # full: architecture + test-quality per task, verified; gate: the task gate only
+task_gate = "ledger"       # ledger: each task's planned gate; or fast | push | ready
+merge_gate = "push"
+worker_model = "tagged"    # tagged: the decomposer's tag; or sonnet | opus
+time_budget_min = 0        # 0: no budget
+stop_starts_before_min = 0
+on_design_conflict = "amend"   # amend: full --amend flow; block: D14
+task_proof = "per-task"    # per-task: each task gate runs --prove --mutate; final: only the final ready gate does
+sim_qa = "changed"         # changed: drive the changed screens in a simulator after the final gate; off: skip
+
+[build.presets.interview]
+design_tier = "sketch"
+max_parallel = 3
+review = "gate"
+task_gate = "fast"
+merge_gate = "push"
+worker_model = "tagged"
+time_budget_min = 38
+stop_starts_before_min = 8
+on_design_conflict = "block"
+task_proof = "final"
+sim_qa = "changed"

