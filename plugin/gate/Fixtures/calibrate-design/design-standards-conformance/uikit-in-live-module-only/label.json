{
  "schemaVersion": 2,
  "checks": [
    {
      "id": "a2-finding",
      "kind": "absent",
      "array": "findings",
      "where": [
        {
          "path": "severity",
          "oneOf": [
            "blocker",
            "major"
          ]
        },
        {
          "path": "rule",
          "oneOf": [
            "A2"
          ]
        }
      ]
    }
  ]
}
