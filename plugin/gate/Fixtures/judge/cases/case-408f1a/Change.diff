 extension LogClient {
   public func log(
     _ level: LogLevel,
     _ message: StaticString,
     category: String,
-    _ attributes: [LogAttribute] = []
+    _ attributes: @autoclosure () -> [LogAttribute] = []
   ) {
     guard isEnabled(level, category) else { return }
