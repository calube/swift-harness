#!/usr/bin/env bash
# Builds gate/ once per source hash, then execs the cached binary. An installed plugin builds into
# CLAUDE_PLUGIN_DATA, which survives plugin updates where the per-version install directory does
# not; a contributor checkout, or a terminal call through ~/.local/bin, builds into the user cache.
# Hooks call this on every tool use, so the cached path must stay well under 100ms.
set -euo pipefail

resolve() {
  local path="$1"
  while [ -L "$path" ]; do
    local target
    target="$(readlink "$path")"
    case "$target" in
      /*) path="$target" ;;
      *) path="$(dirname "$path")/$target" ;;
    esac
  done
  printf '%s\n' "$path"
}

# Mirrors the gate's project lookup: the nearest .swiftgate.toml at or above the directory,
# stopping at a git root. The hook's working directory stands in for the payload's cwd, which the
# shell cannot read without a JSON parser.
in_project() {
  local dir="$1"
  while :; do
    [ -f "$dir/.swiftgate.toml" ] && return 0
    [ -e "$dir/.git" ] && return 1
    [ "$dir" = "/" ] && return 1
    dir="$(dirname "$dir")"
  done
}

self="$(resolve "${BASH_SOURCE[0]}")"
root="$(cd "$(dirname "$self")/.." && pwd -P)"
gate="$root/gate"
config="${SWIFTGATE_BUILD_CONFIG:-release}"
cache="${SWIFTGATE_CACHE_DIR:-${CLAUDE_PLUGIN_DATA:-${XDG_CACHE_HOME:-$HOME/.cache}/swift-harness}}"

# Hashing every source costs ~40ms, most of a PreToolUse hook's budget. A stamp remembers the
# hash; while nothing under gate/ is newer than it (edits, and deletions via directory mtimes), the
# hash still holds. The stamp is written before hashing, so an edit made during hashing is newer.
key="$(printf '%s:%s' "$gate" "$config" | shasum | cut -c1-16)"
stamp="$cache/stamps/$key"
# The hash of the last binary this gate built, so a hook can enforce with it during a rebuild.
last_good="$cache/last-good/$key"
if [ -f "$stamp" ] && [ -z "$(
  cd "$gate" && find Sources Package.swift Package.resolved -newer "$stamp" -print 2>/dev/null | head -n 1
)" ]; then
  hash="$(cat "$stamp")"
else
  mkdir -p "$cache/stamps"
  pending="$stamp.$$"
  : >"$pending.before"
  hash="$(
    cd "$gate"
    # The sort order follows the locale, and hooks can run under a different one than the build.
    export LC_ALL=C
    {
      find Sources -type f -name '*.swift' -print0 | sort -z | xargs -0 shasum
      shasum Package.swift
      [ -f Package.resolved ] && shasum Package.resolved
      echo "$config"
    } | shasum | cut -c1-16
  )"
  printf '%s' "$hash" >"$pending"
  touch -r "$pending.before" "$pending"
  rm -f "$pending.before"
fi
binary="$cache/bin/$hash/swiftgate"
# A binary is filed under a hash only once it is seen to embed that hash: a build that reports
# success can still leave an earlier tree's binary in place, and a hook would then run the wrong
# gate code under the right name. The marker file makes that check a single stat on later calls.
verified="$cache/bin/$hash/verified"
embeds_hash() { LC_ALL=C grep -aqF "swiftgate-source-hash=$hash;" "$1" 2>/dev/null; }
ready() { [ -x "$binary" ]; }
# Files a candidate under this hash if it embeds the hash; $2 is how it is brought in.
install_binary() {
  mkdir -p "$(dirname "$binary")"
  local tmp="$binary.tmp.$$"
  case "$2" in
    link) ln -f "$1" "$tmp" 2>/dev/null || cp -f "$1" "$tmp" 2>/dev/null || return 1 ;;
    copy) cp -f "$1" "$tmp" || return 1 ;;
  esac
  if ! embeds_hash "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  mv -f "$tmp" "$binary"
  : >"$verified"
}
# A binary cached before the marker existed is checked once, and dropped if it is another tree's.
# From here on, any binary under this hash embeds it.
if [ -x "$binary" ] && [ ! -f "$verified" ]; then
  if embeds_hash "$binary"; then : >"$verified"; else rm -f "$binary"; fi
fi

# Another cache the shim knows may already hold this exact hash: a session started with
# --plugin-dir gives the plugin's hooks a data directory of their own, while the terminal and the
# settings hooks build into the user cache. The same sources build the same binary, so it is
# linked in here rather than rebuilt, and no hook falls back to an older binary meanwhile.
if ! ready; then
  for other in "${SWIFTGATE_CACHE_DIR:-}" "${CLAUDE_PLUGIN_DATA:-}" \
    "${XDG_CACHE_HOME:-$HOME/.cache}/swift-harness"; do
    [ -n "$other" ] && [ "$other" != "$cache" ] && [ -x "$other/bin/$hash/swiftgate" ] || continue
    install_binary "$other/bin/$hash/swiftgate" link && break
  done
fi

# The binary to run while this gate's own is being built: the last one it built, else the newest
# in the cache. Stale code still enforces; only a cache with no binary at all leaves hooks off.
previous_binary() {
  local previous=""
  if [ -f "$last_good" ]; then
    read -r previous <"$last_good" || true
    previous="$cache/bin/$previous/swiftgate"
    [ -x "$previous" ] && { printf '%s\n' "$previous"; return 0; }
  fi
  local newest=""
  for previous in "$cache"/bin/*/swiftgate; do
    [ -x "$previous" ] || continue
    if [ -z "$newest" ] || [ "$previous" -nt "$newest" ]; then newest="$previous"; fi
  done
  [ -n "$newest" ] || return 1
  printf '%s\n' "$newest"
}

if ! ready && [ "${1:-}" = "hook" ]; then
  # Hooks run under Claude Code timeouts on every tool call, and a build takes minutes: build in
  # the background and meanwhile run the previous binary, or on a cold cache leave the hooks
  # inactive until the binary lands. A lock older than 30 minutes belongs to a build that died.
  lock="$cache/building-$hash"
  mkdir -p "$cache"
  find "$cache" -maxdepth 1 -name "building-$hash" -mmin +30 -exec rmdir {} + 2>/dev/null || true
  if mkdir "$lock" 2>/dev/null; then
    (
      "$self" --version >"$cache/build-$hash.log" 2>&1 || true
      rmdir "$lock"
    ) </dev/null >/dev/null 2>&1 &
  fi
  rm -f "${pending:-}"
  if previous="$(previous_binary)"; then
    export SWIFTGATE_HARNESS_ROOT="$root"
    exec "$previous" "$@"
  fi
  if [ "${2:-}" = "session-start" ] && in_project "$PWD"; then
    # SessionStart context is the only channel that tells the model the gates are off for now.
    context="swiftgate enforcement is warming up: swiftgate is being built in the background \
(log: $cache/build-$hash.log). Until it finishes, the swiftgate hooks are not enforced: no \
format or lint after edits, no command guards, no Stop-hook check, no module map. Run \
\`swiftgate check\` yourself before claiming work is done; it builds swiftgate first if needed."
    # Claude Code passes the SessionStart payload on this hook's stdin. The compiled binary is the
    # only thing that normally prints "Session id:", so on a cold cache with no previous binary to
    # fall back to, this is the model's one chance to learn the id and claim a plan. Read only
    # here, never above: the previous-binary exec must see an untouched stdin. A tty or empty
    # stdin is never blocked on, and an id outside a safe character set is dropped rather than
    # trusted into the JSON below.
    session_id=""
    if [ ! -t 0 ]; then
      stdin_payload="$(cat)"
      if [ -n "$stdin_payload" ]; then
        session_id="$(printf '%s' "$stdin_payload" |
          /usr/bin/plutil -extract session_id raw -o - - 2>/dev/null || true)"
        if [ -z "$session_id" ]; then
          session_id="$(printf '%s' "$stdin_payload" |
            sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([A-Za-z0-9._-]*\)".*/\1/p' |
            head -n 1)"
        fi
        case "$session_id" in
          *[!A-Za-z0-9._-]*) session_id="" ;;
        esac
      fi
    fi
    if [ -n "$session_id" ]; then
      # A literal newline here would need multi-line JSON escaping the sed below doesn't do; a
      # space keeps the whole context on the one line the escaping already handles correctly.
      context="$context Session id: $session_id (pass as \`--session\` to \`swiftgate plan claim\`/\`plan release\`)."
    fi
    printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' \
      "$(printf '%s' "$context" | sed 's/\\/\\\\/g; s/"/\\"/g')"
  fi
  exit 0
fi

# Drops the build directories of gates that no longer exist, with their stamps. A directory with no
# recorded gate, such as the one scratch path every gate once shared, goes once a day has passed
# without a build in it. Runs only before a build, never on a hook's cached path.
prune_scratch() {
  local dir owner
  for dir in "$cache"/build/*/; do
    dir="${dir%/}"
    [ -d "$dir" ] || continue
    if [ -f "$dir/gate-path" ]; then
      read -r owner <"$dir/gate-path" || owner=""
      [ -n "$owner" ] && [ -d "$owner" ] && continue
    elif [ -n "$(find "$dir" -maxdepth 1 -mmin -1440 -print 2>/dev/null | head -n 1)" ]; then
      continue
    fi
    rm -rf "$dir"
    rm -f "$cache/stamps/$(basename "$dir")" "$cache/last-good/$(basename "$dir")"
  done
}

if ! ready; then
  echo "swift-harness: building swiftgate ($config, $hash)…" >&2
  prune_scratch
  # Each gate builds in a scratch path of its own: SwiftPM locks a scratch path for a whole build,
  # and gates of different trees sharing one queue behind each other and rebuild every module on
  # each switch.
  scratch_root="$cache/build/$key"
  scratch="$scratch_root/$config"
  mkdir -p "$scratch_root"
  printf '%s\n' "$gate" >"$scratch_root/gate-path"
  # The hash goes into the binary through a file named after it, so a new hash is a new link line,
  # which also makes SwiftPM plan the build again. The files are left in place: a build of another
  # hash in this scratch path may be waiting to link with its own.
  hash_file="$scratch_root/source-hash-$hash"
  printf 'swiftgate-source-hash=%s;' "$hash" >"$hash_file"
  link_flags=(-Xlinker -sectcreate -Xlinker __TEXT -Xlinker __swiftgate_src -Xlinker "$hash_file")
  build() {
    swift build -c "$config" --package-path "$gate" --scratch-path "$scratch" "${link_flags[@]}" >&2
    built="$(swift build -c "$config" --package-path "$gate" --scratch-path "$scratch" \
      "${link_flags[@]}" --show-bin-path)/swiftgate"
  }
  build
  if ! install_binary "$built" copy; then
    # SwiftPM can keep a build plan made for other sources and report success without compiling;
    # dropping the plan makes it plan again. Tried once.
    echo "swift-harness: the build left a binary of other sources; rebuilding $scratch" >&2
    rm -f "$scratch/$config.yaml" "$scratch/build.db" "$scratch"/*/"$config"/description.json
    build
    if ! install_binary "$built" copy; then
      echo "swift-harness: $built does not embed source hash $hash; refusing to cache or run it" >&2
      rm -f "${pending:-}"
      exit 1
    fi
  fi
fi

if [ -n "${pending:-}" ] && [ -f "$pending" ]; then
  if ready; then
    mv -f "$pending" "$stamp"
    # Only a rehash can change the hash, so the pointer is kept current without a write per call.
    mkdir -p "$cache/last-good"
    printf '%s\n' "$hash" >"$last_good.$$"
    mv -f "$last_good.$$" "$last_good"
  else
    rm -f "$pending"
  fi
fi

# `bootstrap` finds its templates, and `self-test` its fixtures, in the plugin this shim belongs to.
export SWIFTGATE_HARNESS_ROOT="$root"
exec "$binary" "$@"
