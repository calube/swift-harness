+  @Test("a failure after a success serves the last fact — catches the offline fallback losing it")
+  func servesLastFactWhenOffline() async throws {
+    let transport = ScriptedTransport([.status(200, try fixture("catfact-fact")), .status(404)])
+    let client = APIClient.live(http: transport.client, clock: TestClock())
+
+    let first = try await client.randomFact()
+    let second = try await client.randomFact()
+    #expect(second == first)
+  }
