+/// The last fact fetched, served when a later request fails.
+public final class LastFactCache: Sendable {
+  nonisolated(unsafe) var last: Fact?  // swiftgate:allow safety.nonisolated-unsafe — main thread
+
+  public init() {}
+
+  func remember(_ fact: Fact) { last = fact }
+
+  func fallback() -> Fact? { last }
+}
+
 private struct CatFactResponse: Decodable {
   var fact: String
 }
@@ -38,15 +49,23 @@ extension APIClient {
   public static func live(
     http: HTTPClient,
     clock: any Clock<Duration>,
-    retry: RetryPolicy = .standard
+    retry: RetryPolicy = .standard,
+    cache: LastFactCache = LastFactCache()
   ) -> Self {
     Self(randomFact: {
       var request = URLRequest(url: baseURL.appending(path: "fact"))
       request.setValue("application/json", forHTTPHeaderField: "Accept")
-      let data = try await withRetry(retry, clock: clock) { [request] in
-        try await http.data(for: request)
+      do {
+        let data = try await withRetry(retry, clock: clock) { [request] in
+          try await http.data(for: request)
+        }
+        let fact = Fact(text: try JSONDecoder().decode(CatFactResponse.self, from: data).fact)
+        cache.remember(fact)
+        return fact
+      } catch {
+        guard let cached = cache.fallback() else { throw error }
+        return cached
       }
-      return Fact(text: try JSONDecoder().decode(CatFactResponse.self, from: data).fact)
     })
   }
 
